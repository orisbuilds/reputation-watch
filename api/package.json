{
  "name": "reputation-watch-api",
  "version": "1.0.0",
  "private": true,
  "description": "Reputation Watch backend — Cloudflare Worker + D1 + Resend",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute reputation-watch --file=./schema.sql --remote",
    "db:init-local": "wrangler d1 execute reputation-watch --file=./schema.sql --local"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
